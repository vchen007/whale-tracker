# Kalshi API credentials
# Get these from https://kalshi.com/account/api
KALSHI_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Alternative for cloud deployment: paste PEM content directly (newlines as \n)
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...

# Authentication — required for auto-trader endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN=your-secret-token-here

# CORS — comma-separated allowed origins (default: http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Client API URL — set when building the Vite client for production
# VITE_API_URL=https://your-api-domain.com

# Optional
PORT=3001

# Auto-trader (all optional — defaults shown)
AUTO_TRADER_ENABLED=true
AUTO_TRADER_CATEGORY=Sports
AUTO_TRADER_COUNT=1
AUTO_TRADER_MIN_NOTIONAL=20000
AUTO_TRADER_MIN_NET_PROFIT=0.02
AUTO_TRADER_STOP_LOSS_ENABLED=true
AUTO_TRADER_STOP_LOSS_PERCENT=70
# Entry price sweet spot (70-84¢ per P&L analysis). Set MAX to 100 to disable upper bound.
AUTO_TRADER_MIN_PRICE_CENTS=65
AUTO_TRADER_MAX_PRICE_CENTS=84
# Comma-separated ticker prefixes to skip. Defaults are the known losing subcategories.
# AUTO_TRADER_BLOCKED_PREFIXES=KXNBASPREAD,KXIPL,KXATPMATCH,KXWTAMATCH,KXITFMATCH,KXUFCFIGHT
# Skip if we already hold an open position on the same event (prevents stacking).
AUTO_TRADER_DEDUPE_BY_EVENT=true
