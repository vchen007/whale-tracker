# Kalshi API credentials
# Get these from https://kalshi.com/account/api
KALSHI_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# Alternative for cloud deployment: paste PEM content directly (newlines as \n)
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...

# ── Kalshi environment ────────────────────────────────────────────────────────
# Switch the WHOLE bot to the demo (paper-money) environment — no code edits.
# Leave unset for production (https://api.elections.kalshi.com/trade-api/v2).
# Demo needs DEMO API credentials above (a separate key from prod).
# KALSHI_API_BASE=https://demo-api.kalshi.co/trade-api/v2
#
# Advanced: route ONLY order placement to a different env (real whale signals
# from prod, orders safely in demo). Note: maker mode prices against the order's
# own env book, so a near-empty demo book makes most maker orders skip.
# KALSHI_TRADING_API_BASE=https://demo-api.kalshi.co/trade-api/v2
#
# Explicit WebSocket override. Honored ONLY when KALSHI_API_BASE is unset —
# setting KALSHI_API_BASE always derives (and moves) the WebSocket too.
# KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2

# Authentication — required for auto-trader endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_TOKEN=your-secret-token-here

# CORS — comma-separated allowed origins (default: http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173,https://your-domain.com

# Client API URL — set when building the Vite client for production
# VITE_API_URL=https://your-api-domain.com

# Optional
PORT=3001

# Auto-trader (all optional — defaults shown)
AUTO_TRADER_ENABLED=true
AUTO_TRADER_CATEGORY=Sports
AUTO_TRADER_COUNT=1
AUTO_TRADER_MIN_NOTIONAL=20000
AUTO_TRADER_MIN_NET_PROFIT=0.02
# Maker mode: post resting limit orders inside the spread rather than crossing as
# a taker. Makers average −9.6% vs Takers −31.5% (makers/takers paper) — this is
# the single biggest EV lever. Set to 'false' to revert to taker copy-trading.
AUTO_TRADER_MAKER_MODE=true
# Maker fee coefficient: fee/contract = coeff × P × (1−P). Default 0.07 (== taker,
# conservative) since Kalshi's maker rate varies by market. Lower to your verified
# rate from https://kalshi.com/fee-schedule.
AUTO_TRADER_MAKER_FEE_COEFF=0.07
# Cancel a resting (unfilled) maker order after this many minutes — never chase.
AUTO_TRADER_UNFILLED_TTL_MIN=10
AUTO_TRADER_STOP_LOSS_ENABLED=true
AUTO_TRADER_STOP_LOSS_PERCENT=70
# Entry price floor 70¢ = the statistically-significant favorites zone in the
# paper. Set MAX to 100 to disable the upper bound.
AUTO_TRADER_MIN_PRICE_CENTS=70
AUTO_TRADER_MAX_PRICE_CENTS=84
# Comma-separated ticker prefixes to skip. Defaults are the known losing subcategories.
# AUTO_TRADER_BLOCKED_PREFIXES=KXNBASPREAD,KXIPL,KXATPMATCH,KXWTAMATCH,KXITFMATCH,KXUFCFIGHT
# Skip if we already hold an open position on the same event (prevents stacking).
AUTO_TRADER_DEDUPE_BY_EVENT=true
# ── Calibrated EV gate (favorite–longshot correction, makers/takers paper) ────
# Win prob q ≈ (P + ALPHA + PSI·P)/100; orders need probability-weighted EV
# after fees > MIN_EV. With defaults this narrows entries to ~84–94¢ — set
# AUTO_TRADER_MAX_PRICE_CENTS=94 to use the full zone. Fit your own ALPHA/PSI
# from settled data with: npm run backfill:outcomes (then --fit).
AUTO_TRADER_CALIBRATED_EV=true
# AUTO_TRADER_CALIBRATION_ALPHA=-1.736
# AUTO_TRADER_CALIBRATION_PSI=0.034
# AUTO_TRADER_MIN_EV=0

# ── Cross-venue arb detector (prod data only; detection, never executes) ──────
# Emails [ARB] alerts when the same event prices differently on Kalshi vs
# Polymarket by more than the fee. One-shot scan: npm run arb:scan
ARB_SCAN_ENABLED=true
# ARB_MIN_NET_CENTS=4
# ARB_WINDOW_HOURS=6
# ARB_MATCH_THRESHOLD=0.7

# ── Bankroll rails (autonomous safety; <=0 disables a given cap) ──────────────
# Max total open notional in dollars across all positions.
AUTO_TRADER_MAX_CAPITAL=500
# Max concurrent committed positions (resting + filled).
AUTO_TRADER_MAX_OPEN_POSITIONS=25
# Max concurrent committed + in-flight orders on the SAME ticker. Belt-and-
# suspenders alongside AUTO_TRADER_DEDUPE_BY_EVENT (which already prevents >1
# per event by default). <=0 disables.
AUTO_TRADER_MAX_PER_TICKER=5
# Realized-loss kill-switch: disable the trader once a day's realized P&L <= -$N.
AUTO_TRADER_MAX_DAILY_LOSS=100
